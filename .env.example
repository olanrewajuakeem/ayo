# Copy to .env and fill in. .env is gitignored — this repo is public.

# The agent wallet's private key. Only src/tag.ts uses it, to send one
# deliberately attributed transaction. Stitch holds its own copy in an
# owner-only file and does not read this.
AGENT_PRIVATE_KEY=0x

# Issued by Loops at enrollment. Defaults are already correct for this entry;
# set these only if the tag changes (for example on joining a team).
# CELO_ATTRIBUTION_TAG=celo_fb726b4b2e54
# CELO_DATA_SUFFIX=0x63656c6f5f666237323662346232653534110080218021802180218021802180218021

# Free and rate-limited. Swap for a dedicated endpoint if quoting gets busy.
# CELO_RPC_URL=https://forno.celo.org

# Where the feed reads Mento's independent naira price.
# MENTO_FEED_URL=https://cowrie-seven.vercel.app
